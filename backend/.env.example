PORT=3000
# Production behind Nginx: HOST=127.0.0.1
HOST=0.0.0.0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=flowboard
MYSQL_USER=flowboard
MYSQL_PASSWORD=replace_locally
MYSQL_POOL_SIZE=3
MAX_ROOMS=200
MAX_ACTIVE_ROOMS=20
MAX_CONNECTIONS=40
MAX_WS_MESSAGE_BYTES=4259840
MAX_DOCUMENT_BYTES=4194304
SAVE_INTERVAL_MS=2000
SAVE_RETRY_BASE_MS=1000
SAVE_RETRIES=3
SHUTDOWN_TIMEOUT_MS=12000
