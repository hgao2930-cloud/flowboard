# Optional override. Development defaults to ws(s)://<current hostname>:3000.
# Production defaults to ws(s)://<current host>/flowboard/ws, behind the same-site Nginx proxy.
# Vite also proxies /api to this server's HTTP(S) origin (default: http://127.0.0.1:3000).
# Restart the frontend dev server after changing this value.
VITE_WS_URL=ws://127.0.0.1:3000
